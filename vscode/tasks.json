{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar e Rodar C",
            "command": "gcc",
            "args": [
                "${file}",
                "-o",
                "${workspaceFolder}/${fileBasenameNoExtension}.exe",
                "&&",
                "${workspaceFolder}/${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}